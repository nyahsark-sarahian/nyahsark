{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "nyahsark-stripe-sandbox",
  "main": "src/index.js",
  "compatibility_date": "2026-11-22",
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "STRIPE_MODE": "sandbox",
    "STRIPE_MERCHANT_REFERENCE": "replace-with-test-stripe-account-reference",
    "STRIPE_API_VERSION": "2026-11-18.endive",
    "STRIPE_RETURN_ORIGIN": "https://nyahsark.com"
  }
}
