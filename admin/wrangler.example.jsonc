{
  "name": "nyahsark-admin-staging",
  "main": "src/entrypoint.js",
  "compatibility_date": "2026-11-19",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "ui",
    "binding": "ASSETS",
    "html_handling": "none",
    "run_worker_first": true
  },
  "ai": {"binding": "AI"},
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nyahsark-admin-staging",
      "database_id": "REPLACE_WITH_EXISTING_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],
  "images": {"binding": "IMAGE_TRANSFORM"},
  "rules": [
    {"type": "Text", "globs": ["**/*.sql"], "fallthrough": true}
  ],
  "vars": {
    "STAGING_ENABLED": "no",
    "CALIBRATION_MODE": "no",
    "ADMIN_ORIGIN": "https://thearkadmin.nyahsark.com",
    "STOREFRONT_ORIGIN": "https://nyahsark.com",
    "SUPABASE_URL": "https://REPLACE.supabase.co",
    "SUPABASE_PUBLISHABLE_KEY": "sb_publishable_REPLACE",
    "SARAH_AUTH_SUB": "REPLACE_WITH_EXISTING_SUBJECT",
    "IMAGE_TRANSFORM_QUALIFIED": "no",
    "AI_ASSIST_ENABLED": "no",
    "AI_ASSIST_MODEL": "@cf/meta/llama-4-scout-17b-16e-instruct",
    "AI_GATEWAY_ID": "",
    "AI_ASSIST_JSON_MODE": "yes",
    "AI_MONTHLY_REQUEST_CAP": "100",
    "AI_MONTHLY_BUDGET_CENTS": "500",
    "AI_MAX_IMAGES_PER_ACTION": "4"
  }
}

